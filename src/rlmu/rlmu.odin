		for col in 0 ..< 16 {
			alpha := folder_icon_alpha[row][col]
			if alpha != 0 {
				idx := (104 + row) * mu.DEFAULT_ATLAS_WIDTH + (40 + col)
				pixels[idx] = {255, 255, 255, alpha}
			}
		}
	}

	// Create a raylib Image whose data is the pixels we just allocated.
	image := rl.Image {
		data    = raw_data(pixels),
		width   = mu.DEFAULT_ATLAS_WIDTH,
		height  = mu.DEFAULT_ATLAS_HEIGHT,
		format  = .UNCOMPRESSED_R8G8B8A8,
		mipmaps = 1,
	}

	state.atlas = rl.LoadTextureFromImage(image)
	rl.SetTextureFilter(state.atlas, .POINT) // keep pixel glyphs crisp

	delete(pixels)
	image = {}

	// TTF font for the timer display.
	state.timer_font_size = 28
	state.timer_font = rl.LoadFontEx(
		"/System/Library/Fonts/SFNS.ttf",
		c.int(state.timer_font_size),
		nil,
		0,
	)
	if state.timer_font.glyphCount <= 1 {
		state.timer_font = rl.GetFontDefault()
	}
	rl.SetTextureFilter(state.timer_font.texture, .POINT)

	// Playlist rows use raylib's built-in pixel font at native size (1x).
	state.list_font_size = f32(rl.GetFontDefault().baseSize)

	mu.init(ctx = &state.ctx)
	state.ctx.text_width = mu.default_atlas_text_width
	state.ctx.text_height = mu.default_atlas_text_height
	state.ctx.textbox_state.set_clipboard = set_clipboard
	state.ctx.textbox_state.get_clipboard = get_clipboard
}

// Frees atlas texture and timer font allocated by `init`.
destroy :: proc(state := global_state) {
	rl.UnloadTexture(state.atlas)
	if state.timer_font.texture.id != rl.GetFontDefault().texture.id {
		rl.UnloadFont(state.timer_font)
	}
}

// Stores a timer label drawn in `end` with the large TTF font.
set_timer_label :: proc(text : string, rect : mu.Rect, state := global_state) {
	state.timer_label = text
	state.timer_rect = rect
}

// Defers a playlist label, drawn in `end` with the pixel font.
set_list_label :: proc(
	text : string,
	rect : mu.Rect,
	align := List_Label_Align.Left,
	color : mu.Color = {0, 255, 65, 255},
	clipped := true, // scissor to the panel body, like playlist rows
	state := global_state,
) {
	if state.list_label_count >= MAX_LIST_LABELS { return }
	state.list_labels[state.list_label_count] = List_Label {
		text    = text,
		rect    = rect,
		align   = align,
		color   = color,
		clipped = clipped,
	}
	state.list_label_count += 1
}

// Clips deferred list labels to `rect` (the playlist panel body).
set_list_clip :: proc(
	rect : mu.Rect,
	enabled : bool = true,
	state := global_state,
) {
	state.list_clip = rect
	state.list_clip_set = enabled
}

// Renders deferred playlist labels with raylib's built-in pixel font.
@(private)
draw_list_labels :: proc(state := global_state) {
	if state.list_label_count == 0 { return }

	font := rl.GetFontDefault()
	font_size := state.list_font_size
	label_spacing := f32(1.0)
	rl.SetTextureFilter(font.texture, .POINT)

	for i in 0 ..< state.list_label_count {
		label := state.list_labels[i]
		if len(label.text) == 0 { continue }

		if label.clipped && state.list_clip_set {
			rl.BeginScissorMode(
				state.list_clip.x,
				state.list_clip.y,
				state.list_clip.w,
				state.list_clip.h,
			)
		}

		label_cstr, cstr_err := strings.clone_to_cstring(
			label.text,
			context.temp_allocator,
		)
		if cstr_err != nil { continue }
		text_width := rl.MeasureTextEx(
			font,
			label_cstr,
			font_size,
			label_spacing,
		)

		x : f32
		switch label.align {
		case .Left:
			x = f32(i32(f32(label.rect.x) + 0.5))
		case .Center:
			x = f32(
				i32(
					f32(label.rect.x) +
					(f32(label.rect.w) - text_width.x) / 2 +
					0.5,
				),
			)
		case .Right:
			x = f32(i32(f32(label.rect.x + label.rect.w) - text_width.x + 0.5))
		}
		y := f32(
			i32(f32(label.rect.y) + (f32(label.rect.h) - font_size) / 2 + 0.5),
		)

		rl.DrawTextEx(
			font,
			label_cstr,
			{x, y},
			font_size,
			label_spacing,
			transmute(rl.Color)label.color,
		)

		if label.clipped && state.list_clip_set {
			rl.EndScissorMode()
		}
	}
}

// Forwards all input from raylib to mui, then begins a microui frame.
// Returns a pointer to the microui context so the caller can issue UI calls.
begin :: proc(state : ^RLMU_State = global_state) -> ^mu.Context {
	forward_text_input(state)
	forward_mouse_input(state)
	forward_keyboard_input(state)

	mu.begin(&state.ctx)
	return &state.ctx
}

// Ends a microui frame and renders the recorded command list via raylib.
end :: proc(state := global_state) {
	mu.end(&state.ctx)

	current_command : ^mu.Command
	for cmd_variant in mu.next_command_iterator(&state.ctx, &current_command) {
		#partial switch cmd in cmd_variant {
		case ^mu.Command_Text:
			draw_position := [2]i32{cmd.pos.x, cmd.pos.y}
			for char in cmd.str do if !is_utf8_continuation_byte(char) {
				ascii := char_to_ascii(char)
				rect := mu.default_atlas[mu.DEFAULT_ATLAS_FONT + ascii]
				draw_mu_atlas_texture(state.atlas, rect, draw_position, cmd.color)
				draw_position.x += rect.w
			}
		case ^mu.Command_Rect:
			rl.DrawRectangle(
				cmd.rect.x,
				cmd.rect.y,
				cmd.rect.w,
				cmd.rect.h,
				transmute(rl.Color)cmd.color,
			)
		case ^mu.Command_Icon:
			rect := mu.default_atlas[cmd.id]
			x := cmd.rect.x + (cmd.rect.w - rect.w) / 2
			y := cmd.rect.y + (cmd.rect.h - rect.h) / 2
			draw_mu_atlas_texture(state.atlas, rect, {x, y}, cmd.color)
		case ^mu.Command_Clip:
			rl.EndScissorMode()
			rl.BeginScissorMode(cmd.rect.x, cmd.rect.y, cmd.rect.w, cmd.rect.h)
		}
	}

	// End any lingering scissor mode so clipping can't leak into the next frame.
	rl.EndScissorMode()

	// Draw the timer label with the larger TTF font, if one was set this frame.
	if len(state.timer_label) > 0 {
		font := state.timer_font
		font_size := state.timer_font_size
		label_cstr, cstr_err := strings.clone_to_cstring(
			state.timer_label,
			context.temp_allocator,
		)
		if cstr_err == nil {
			text_width := rl.MeasureTextEx(font, label_cstr, font_size, 1.0)
			text_x := f32(
				i32(
					f32(state.timer_rect.x) +
					(f32(state.timer_rect.w) - text_width.x) / 2 +
					0.5,
				),
			)
			text_y := f32(
				i32(
					f32(state.timer_rect.y) +
					(f32(state.timer_rect.h) - font_size) / 2 +
					0.5,
				),
			)
			rl.DrawTextEx(
				font,
				label_cstr,
				{text_x, text_y},
				font_size,
				1.0,
				rl.Color{0, 255, 65, 255},
			)
		}
		state.timer_label = ""
	}

	draw_list_labels()
	state.list_label_count = 0
	state.list_clip_set = false
}

// Convenience wrapper: `init`
// Usage: `ctx := rlmu.init_scope()`
init_scope :: proc(state := global_state) -> ^mu.Context {
	init(state)
	return &state.ctx
}

// Convenience wrapper: `begin` + auto `end` at scope exit.
// Usage: `rlmu.begin_scope()` at the top of each frame.
@(deferred_in = end)
begin_scope :: proc(state := global_state) -> ^mu.Context {
	begin(state)
	return &state.ctx
}

// Sends the current text (typing) input from raylib to mui.
@(private)
forward_text_input :: proc(state : ^RLMU_State) {
	text_input : [512]byte = ---
	text_input_offset := 0

	for text_input_offset < len(text_input) {
		pressed_rune := rl.GetCharPressed()
		if pressed_rune == 0 do break

		bytes, count := utf8.encode_rune(pressed_rune)
		copy(text_input[text_input_offset:], bytes[:count])
		text_input_offset += count
	}

	mu.input_text(&state.ctx, string(text_input[:text_input_offset]))
}

// Sends the current mouse input from raylib to mui.
@(private)
forward_mouse_input :: proc(state : ^RLMU_State) {
	mouse_position := [2]i32{rl.GetMouseX(), rl.GetMouseY()}
	mouse_scroll := rl.GetMouseWheelMove() * -30

	mu.input_mouse_move(&state.ctx, mouse_position.x, mouse_position.y)
	mu.input_scroll(&state.ctx, 0, i32(mouse_scroll))

	MouseButtonMapping :: struct {
		rl : rl.MouseButton,
		mu : mu.Mouse,
	}

	@(static) MouseButtonMappings := [?]MouseButtonMapping {
		{.LEFT, .LEFT},
		{.RIGHT, .RIGHT},
		{.MIDDLE, .MIDDLE},
	}

	for button in MouseButtonMappings {
		if rl.IsMouseButtonPressed(button.rl) {
			mu.input_mouse_down(
				&state.ctx,
				mouse_position.x,
				mouse_position.y,
				button.mu,
			)
		} else if rl.IsMouseButtonReleased(button.rl) {
			mu.input_mouse_up(
				&state.ctx,
				mouse_position.x,
				mouse_position.y,
				button.mu,
			)
		}
	}
}

// Sends the current keyboard input from raylib to mui.
@(private)
forward_keyboard_input :: proc(state : ^RLMU_State) {
	KeyMapping :: struct {
		rl : rl.KeyboardKey,
		mu : mu.Key,
	}

	@(static) KeyMappings := [?]KeyMapping {
		{.LEFT_SHIFT, .SHIFT},
		{.RIGHT_SHIFT, .SHIFT},
		{.LEFT_CONTROL, .CTRL},
		{.RIGHT_CONTROL, .CTRL},
		{.LEFT_ALT, .ALT},
		{.RIGHT_ALT, .ALT},
		{.ENTER, .RETURN},
		{.KP_ENTER, .RETURN},
		{.BACKSPACE, .BACKSPACE},
		{.DELETE, .DELETE},
		{.END, .END},
		{.HOME, .HOME},
		{.LEFT, .LEFT},
		{.RIGHT, .RIGHT},
		{.A, .A},
		{.C, .C},
		{.V, .V},
		{.X, .X},
	}

	for key in KeyMappings {
		if rl.IsKeyPressed(key.rl) {
			mu.input_key_down(&state.ctx, key.mu)
		} else if rl.IsKeyReleased(key.rl) {
			mu.input_key_up(&state.ctx, key.mu)
		}
	}
}

// Draws a section of the mui atlas to the screen with a tint.
// The target_position it draws to will be the top left of the drawn texture.
@(private)
draw_mu_atlas_texture :: proc(
	atlas : rl.Texture2D,
	atlas_source : mu.Rect,
	target_position : [2]i32,
	color : mu.Color,
) {
	rl_target_position := rl.Vector2 {
		f32(target_position.x),
		f32(target_position.y),
	}
	rl_atlas_source := rl.Rectangle {
		f32(atlas_source.x),
		f32(atlas_source.y),
		f32(atlas_source.w),
		f32(atlas_source.h),
	}

	// mu.Color and rl.Color have identical memory layout.
	rl.DrawTextureRec(
		atlas,
		rl_atlas_source,
		rl_target_position,
		transmute(rl.Color)color,
	)
}

@(private)
set_clipboard :: proc(user_data : rawptr, text : string) -> (ok : bool) {
	ctext, err := strings.clone_to_cstring(text, context.temp_allocator)
	if err == .None {
		rl.SetClipboardText(ctext)
		return true
	}
	return false
}

@(private)
get_clipboard :: proc(user_data : rawptr) -> (text : string, ok : bool) {
	ctext := rl.GetClipboardText()
	if ctext == nil || len(ctext) == 0 {
		ok = false
		return
	}

	clipboard_text, err := strings.clone_from_cstring(
		ctext,
		context.temp_allocator,
	)
	text = clipboard_text
	ok = err == .None
	return
}

// Checks if the character is a continuation byte in UTF-8 encoding.
@(private)
is_utf8_continuation_byte :: proc(char : rune) -> bool {
	return char & 0xc0 == 0x80
}

@(private)
char_to_ascii :: proc(char : rune) -> int {
	return min(int(char), 127)
}
