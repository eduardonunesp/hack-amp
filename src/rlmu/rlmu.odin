package rlmu

// Bridges libs:microui to vendor:raylib: owns the atlas texture, forwards
// input, and renders microui commands with raylib.

import "base:runtime"
import "core:c"
import "core:strings"
import "core:unicode/utf8"
import mu "libs:microui"
import rl "vendor:raylib"

@(private)
Color32 :: [4]u8

MAX_LIST_LABELS :: 256

List_Label_Align :: enum {
	Left,
	Center,
	Right,
}

// Deferred label drawn in `end` with raylib's pixel font.
// Text must outlive the frame (e.g. point into context.temp_allocator).
List_Label :: struct {
	text    : string,
	rect    : mu.Rect,
	align   : List_Label_Align,
	color   : mu.Color,
	clipped : bool, // scissor to `list_clip` when set
}

RLMU_State :: struct {
	atlas            : rl.Texture2D,
	ctx              : mu.Context,
	timer_font       : rl.Font,
	timer_font_size  : f32,
	timer_label      : string,
	timer_rect       : mu.Rect,
	list_font_size   : f32,
	list_label_count : int,
	list_labels      : [MAX_LIST_LABELS]List_Label,
	list_clip        : mu.Rect,
	list_clip_set    : bool,
}

global_state : ^RLMU_State

@(init)
rlmu_init :: proc "contextless" () {
	context = runtime.default_context()
	global_state = new(RLMU_State)
}

// Builds the microui default atlas into a raylib texture, initializes the
// microui context, and wires up text measurement and clipboard callbacks.
init :: proc(state := global_state) {
	pixels := make([]Color32, mu.DEFAULT_ATLAS_WIDTH * mu.DEFAULT_ATLAS_HEIGHT)

	// The default atlas only stores alpha; copy it into the alpha channel.
	for alpha, i in mu.default_atlas_alpha do pixels[i] = {255, 255, 255, alpha}

	// --- Custom icons ---
	// The default atlas (128x128) has free space in rows 84-127.
	// We register icon rects at runtime (the Icon enum already defines them)
	// and blit their alpha pixels into the texture buffer.

	// Play icon: right-pointing triangle at {0, 84, 16, 16}
	mu.default_atlas[int(mu.Icon.PLAY)] = mu.Rect{0, 84, 16, 16}
